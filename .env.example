# TicketYard / DHG Register — example environment variables.
# Copy the values you need into your own shell/session config.
# Never commit a file with real values filled in.

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/ticketyard

# Shared login credential for the app-wide auth gate (a single shared
# account, not per-user accounts). Change both before any real deployment.
APP_LOGIN_USER=dhg
APP_LOGIN_PASSWORD=change-me

# Signs the session cookie set on successful login (cookie-parser's signed
# cookies, HMAC-based). Use a long, random, unpredictable value — e.g.
# `openssl rand -base64 32` — and keep it secret; anyone who has it can
# forge a valid session cookie. Must be at least 16 characters.
SESSION_SECRET=change-me-to-a-long-random-string
